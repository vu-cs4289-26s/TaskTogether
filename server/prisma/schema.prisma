generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum IssuePriority {
  URGENT
  MEDIUM
  LOW
}

enum IssueType {
  MAINTENANCE
  HOUSEMATE_CONFLICT
  NOISE_COMPLAINT
  CLEANLINESS
  OTHER
}

enum ActivityType {
  HOMEWORK
  BONDING
  CHORE
  OTHER
}

enum ActivityStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_UPCOMING
  ISSUE_STATUS_CHANGED
  EVENT_UPCOMING
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String 
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // track password changes
  passwordUpdatedAt DateTime @default(now())

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorCode String?
  twoFactorCodeExpiry DateTime?

  // Household memberships (many-to-many via join table)
  householdMemberships HouseholdMember[]

  // Tasks
  createdTasks   Task[]           @relation("TaskCreator")
  assignedTasks  TaskAssignment[]
  completedTasks TaskCompletion[]

  // Issues
  reportedIssues Issue[]        @relation("IssueReporter")
  issueComments  IssueComment[]

  // Quality Time
  activityParticipants ActivityParticipant[]
  activityCheckIns     ActivityCheckIn[]

  // Household delete votes
  deleteVotes HouseholdDeleteVote[]

  // Notifications
  notifications Notification[] @relation("UserNotifications")

  // Wiki
  wikiSectionsUpdated WikiSection[] @relation("WikiUpdatedBy")

  @@index([email])
}

// ============================================
// HOUSEHOLD (Multi-tenant)
// ============================================

model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Members (many-to-many via join table)
  members HouseholdMember[]

  // Household data
  tasks         Task[]
  issues        Issue[]
  rules         HouseholdRule[]
  activities    QualityTimeActivity[]
  invites       HouseholdInvite[]
  deleteVotes   HouseholdDeleteVote[]
  notifications Notification[]
  wikiSections  WikiSection[]
}

model HouseholdMember {
  id        String   @id @default(uuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
}

model HouseholdInvite {
  id        String    @id @default(uuid())
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([householdId])
  @@index([expiresAt])
}

model HouseholdDeleteVote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  voterId String
  voter   User   @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([householdId, voterId])
  @@index([householdId])
  @@index([voterId])
}

// ============================================
// TASK SYSTEM
// ============================================

model Task {
  id                String    @id @default(uuid())
  title             String
  description       String?
  dueDate           DateTime?
  isRecurring       Boolean   @default(false)
  recurrencePattern String? // "daily", "weekly", "monthly"
  isRotating        Boolean   @default(false)
  rotationIndex     Int       @default(0) // which member is next (0-based, sorted by HouseholdMember.createdAt ASC)
  priority          String?   @default("medium") // "low", "medium", "high"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Assignments and completions
  assignments TaskAssignment[]
  completions TaskCompletion[]

  @@index([householdId])
  @@index([creatorId])
  @@index([dueDate])
  @@index([isRecurring])
  @@index([isRotating])
}

model TaskAssignment {
  id         String     @id @default(uuid())
  status     TaskStatus @default(PENDING)
  notifiedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@index([status])
}

model TaskCompletion {
  id          String   @id @default(uuid())
  photoUrl    String? // Optional proof photo
  notes       String?
  completedAt DateTime @default(now())

  // Relations
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([completedAt])
}

// ============================================
// ISSUE TRACKING
// ============================================

model Issue {
  id          String      @id @default(uuid())
  title       String
  description String?
  photoUrl    String?
  status      IssueStatus @default(OPEN)

  type        IssueType     @default(MAINTENANCE)
  priority    IssuePriority @default(MEDIUM)
  isAnonymous Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportedById String
  reportedBy   User   @relation("IssueReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  comments IssueComment[]

  @@index([householdId])
  @@index([status])
  @@index([type])
  @@index([priority])
}

model IssueComment {
  id        String   @id @default(uuid())
  content   String
  photoUrl  String? // Optional photo for resolution
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  issueId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// QUALITY TIME SCHEDULER (Family Mode)
// ============================================

model QualityTimeActivity {
  id           String         @id @default(uuid())
  title        String
  description  String?
  activityType ActivityType
  status       ActivityStatus @default(SCHEDULED)
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Participants and check-ins
  participants ActivityParticipant[]
  checkIns     ActivityCheckIn[]

  @@index([householdId])
  @@index([scheduledAt])
  @@index([status])
  @@index([activityType])
}

model ActivityParticipant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relations
  activityId String
  activity   QualityTimeActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model ActivityCheckIn {
  id          String   @id @default(uuid())
  photoUrl    String? // Photo check-in proof
  notes       String?
  checkedInAt DateTime @default(now())

  // Relations
  activityId String
  activity   QualityTimeActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([userId])
  @@index([checkedInAt])
}

// ============================================
// HOUSEHOLD RULES/AGREEMENTS
// ============================================

model HouseholdRule {
  id          String   @id @default(uuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  isRead    Boolean          @default(false)
  message   String
  payload   Json?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([householdId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// WIKI SECTIONS
// ============================================

model WikiSection {
  id        String   @id @default(uuid())
  slug      String // e.g. "garbage", "appliances"
  title     String // e.g. "Garbage & Recycling"
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  updatedById String?
  updatedBy   User?   @relation("WikiUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([householdId, slug])
  @@index([householdId])
}


// ============================================
// CHANGE PASSWORD
// ============================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([email])
  @@index([expiresAt])
}